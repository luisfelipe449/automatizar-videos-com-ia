# =============================================================================
# Automatizar Videos com IA — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — Groq (https://console.groq.com)
# Used by:
#   - script_service (chat.completions, Llama 3.3 70B, JSON mode)
#   - caption_service (audio.transcriptions, Whisper large-v3)
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# REQUIRED for TTS — Google AI Studio / Gemini (https://aistudio.google.com)
# Used by:
#   - tts_service (Gemini TTS → PCM → WAV) — REQUIRED
#   - visual_service (Imagen) — OPTIONAL fallback only.
#     Primary image generator is Pollinations.ai (no key required).
#     If you skip Imagen, Pollinations handles 100% of visuals.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# REQUIRED — YouTube Data API v3 OAuth2 (for CLI usage)
# Create OAuth client in Google Cloud Console → Credentials → "Desktop app".
# Then run: python scripts/bootstrap_youtube_oauth.py
# to obtain the refresh token (one-time browser consent).
# -----------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — YouTube OAuth2 Web Credentials (for dashboard OAuth flow)
# Create OAuth client in Google Cloud Console → Credentials → "Web application"
# Set Authorized redirect URI: http://127.0.0.1:8000/accounts/oauth/callback
# This enables the "Add via OAuth" button in the dashboard for easy account setup.
# See docs/GCP_OAUTH_SETUP.md for detailed instructions.
# -----------------------------------------------------------------------------
YOUTUBE_WEB_CLIENT_ID=
YOUTUBE_WEB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL — LLM provider selection for script generation
# -----------------------------------------------------------------------------
# One of: groq | bedrock. Default = groq (free, fast, Llama 3.3).
# Use "bedrock" for Anthropic Claude (paid, AWS Bedrock) when you want
# more creative scripts. If bedrock, also set AWS_BEARER_TOKEN_BEDROCK.
LLM_PROVIDER=groq

# Groq model for script generation
GROQ_MODEL=llama-3.3-70b-versatile

# Bedrock (Claude) — fill in only if LLM_PROVIDER=bedrock.
# Get an API key at AWS console -> Bedrock -> API keys. Includes
# the inference profile; us-east-1 requires the "us." prefix.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Gemini TTS preview model
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Image provider selection: pollinations (default, free) or imagen (paid).
# Whichever is NOT picked here is tried as fallback on failure. Imagen
# needs GEMINI_API_KEY set and a paid Gemini plan.
IMAGE_PROVIDER=pollinations

# Gemini Imagen model (used when IMAGE_PROVIDER=imagen OR as fallback).
# Requires Gemini PAID plan.
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001

# USE_VIDEO_HOOK — optional. When set to true AND USE_VIDEO=false, only
# scene 1 is rendered as a video (via fal.ai LTX Video); scenes 2..N stay
# as images. Cheaper than USE_VIDEO=true (1 clip vs N), captures the
# retention boost of motion in the hook. Falls back to Pollinations image
# if fal.ai credits run out. Ignored when USE_VIDEO=true. Requires FAL_KEY.
USE_VIDEO_HOOK=false

# -----------------------------------------------------------------------------
# OPTIONAL — tooling + upload behavior
# -----------------------------------------------------------------------------
# Absolute path to ffmpeg.exe. If empty, the pipeline falls back to PATH lookup.
# Example (Windows): C:/Users/you/AppData/Local/.../ffmpeg.exe
FFMPEG_PATH=

# YouTube privacy status for uploaded Shorts.
# One of: private | unlisted | public. Default = private (safe for MVP).
YOUTUBE_PRIVACY_STATUS=private

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/app.db
